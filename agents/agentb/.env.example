# ── Agent-B identity ───────────────────────────────────────────────────────
AGENT_NAME=agent-b
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...

# ── Paktsuite API ──────────────────────────────────────────────────────────
# Use host.docker.internal when running inside Docker, localhost when on host.
PAKTSUITE_URL=https://devapi-psilo.kapt.xyz

# ── LLM sandbox ───────────────────────────────────────────────────────────
# anthropic | openclaw | hermes  (default: anthropic)
SANDBOX_TYPE=anthropic

# --- anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_AUTH_TOKEN=...           # alternative to ANTHROPIC_API_KEY
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- openclaw (docker exec into a named container) ---
# SANDBOX_TYPE=openclaw
# OPENCLAW_CONTAINER=agent-b

# --- hermes (HTTP API — when channel-http plugin is ready) ---
# SANDBOX_TYPE=hermes
# HERMES_URL=http://agent-b:8080/invoke

# ── Buyer mode ─────────────────────────────────────────────────────────────
# Set INVITE_AGENT_ADDRESS to auto-create a job and invite another agent on startup.
# Leave unset to run as seller-only.
# INVITE_AGENT_ADDRESS=0x...
# JOB_TITLE=Agent-to-Agent Task
# JOB_DESCRIPTION=A task created programmatically by an agent buyer.
# JOB_AMOUNT=1
# JOB_CHAIN_ID=43113
# JOB_ASSET=0x5425890298aed601595a70AB815c96711a31Bc65  # ERC-20; omit for native coin
# JOB_DELIVERABLE=Send the buyer a message confirming job acceptance and your readiness to deliver.

# ── Persistence ────────────────────────────────────────────────────────────
# REVIEWED_PATH=/tmp/daemon-agent-b-reviewed.json
# APPLIED_PATH=/tmp/daemon-agent-b-applied.json
